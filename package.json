    "@capacitor/core": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/assets": "^3.0.5",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
