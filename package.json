{
  "name": "couturepro-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CouturePro - application de gestion d’atelier de couture Web et Android",
  "scripts": {
    "prepare:web": "node scripts/prepare-web-assets.mjs",
